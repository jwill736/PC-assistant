# Copy to .env — never commit the real one.

# Claude brain (https://console.anthropic.com → API keys; paid, billed separately from a
# Claude subscription). Optional: your own Llama (Ollama, LM Studio) answers without it, and
# everyday commands (apps, volume, scenes, media, tasks, notes) need no model at all.
ANTHROPIC_API_KEY=

# OBS: leave empty — the password is read from OBS's own settings on this PC.
# Only set it if OBS runs on a different machine.
OBS_PASSWORD=

# Calendars: private iCal links. Google: Settings → (calendar) → Integrate
# calendar → "Secret address in iCal format". Outlook: Settings → Calendar →
# Shared calendars → Publish → ICS. iCloud: share calendar → Public → copy link.
CAL_WORK_ICS=
CAL_PERSONAL_ICS=
CAL_STREAM_ICS=

# Google sign-in key (HUD: Setup → Google accounts fills these in; docs/SETUP.md Part 7 makes the key).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
GITHUB_TOKEN=
# Twitch: the Client ID of the app you register at dev.twitch.tv/console (Client Type: Public).
# Then say "connect Twitch". The secret is only for a Confidential app; leave it empty otherwise.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- Vesper 2.0 connections (the HUD fills these in for you; docs/SETUP.md Part 9) ----
# Phone: the token @BotFather gives your Telegram bot; ntfy topic for simple pushes (optional)
TELEGRAM_BOT_TOKEN=
NTFY_TOPIC=
# Spotify: the Client ID of your app at developer.spotify.com (no secret needed)
SPOTIFY_CLIENT_ID=
# Home Assistant: its address and a long-lived access token
HA_URL=
HA_TOKEN=
# YouTube: an API key from Google Cloud (YouTube Data API v3)
YOUTUBE_API_KEY=
# Discord: a channel webhook URL for go-live posts
DISCORD_WEBHOOK_URL=
