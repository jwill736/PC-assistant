# Copy to .env — never commit the real one.

# Claude brain (https://console.anthropic.com → API keys). Without it, the
# offline command router still handles open/close/scenes/media/tasks/briefings.
ANTHROPIC_API_KEY=

# OBS → Tools → WebSocket Server Settings → Enable → Show connect info
OBS_PASSWORD=

# Calendars: private iCal links. Google: Settings → (calendar) → Integrate
# calendar → "Secret address in iCal format". Outlook: Settings → Calendar →
# Shared calendars → Publish → ICS. iCloud: share calendar → Public → copy link.
CAL_WORK_ICS=
CAL_PERSONAL_ICS=
CAL_STREAM_ICS=

# Optional
GITHUB_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
